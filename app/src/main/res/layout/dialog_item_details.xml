<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/rounded_background"
    android:gravity="center_horizontal"
    android:padding="20dp">

    <ImageView
        android:id="@+id/ivDetailImage"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:background="@drawable/weapon_background"
        android:padding="12dp"
        android:src="@drawable/terrablade"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvDetailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-black"
        android:text="Weapon Name"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#55EBCCCC" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="200dp">

        <TextView
            android:id="@+id/tvDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="Weapon description goes here."
            android:textAlignment="center"
            android:textColor="#EBCCCC"
            android:textSize="15sp" />
    </ScrollView>

    <Button
        android:id="@+id/btnCloseDetail"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#8B1E1E"
        android:text="Close"
        android:textColor="#FFFFFF" />

</LinearLayout>

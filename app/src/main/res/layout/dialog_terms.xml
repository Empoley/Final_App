<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/rounded_background"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvTermsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="Terms &amp; Conditions"
        android:textAlignment="center"
        android:textColor="#EBCCCC"
        android:textSize="22sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#55EBCCCC" />

    <ScrollView
        android:id="@+id/scrollTerms"
        android:layout_width="match_parent"
        android:layout_height="280dp">

        <TextView
            android:id="@+id/tvTermsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="#EBCCCC"
            android:textSize="14sp" />
    </ScrollView>

    <TextView
        android:id="@+id/tvScrollHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="▼ Scroll down completely to enable 'I Agree'"
        android:textAlignment="center"
        android:textColor="#FFAAAA"
        android:textSize="12sp"
        android:textStyle="italic" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:background="#55EBCCCC" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDeclineTerms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:backgroundTint="#43000000"
            android:text="Decline"
            android:textColor="#EBCCCC" />

        <Button
            android:id="@+id/btnAcceptTerms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#8B1E1E"
            android:text="I Agree"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>

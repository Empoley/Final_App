<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:background="@drawable/singup"
    android:layout_height="match_parent"
    tools:context=".SignUp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="328dp"
        android:layout_height="563dp"
        android:layout_marginTop="64dp"

        android:background="@drawable/rounded_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:text="Sign Up Page"
            android:textColor="#EBCCCC"
            android:textSize="30dp"
            android:textStyle="italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/emailEdit"
            android:layout_width="290dp"
            android:layout_height="45dp"
            android:layout_marginTop="52dp"
            android:background="@drawable/signin_background"
            android:hint="Email"
            android:padding="5dp"
            android:textColor="#EBCCCC"
            android:textColorHint="#EBCCCC"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView3" />

        <EditText
            android:id="@+id/userEdit"
            android:layout_width="290dp"
            android:layout_height="45dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/signin_background"
            android:hint="Username"
            android:padding="5dp"
            android:textColor="#EBCCCC"
            android:textColorHint="#EBCCCC"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/emailEdit" />

        <EditText
            android:inputType="textPassword"
            android:id="@+id/passEdit"
            android:layout_width="290dp"
            android:layout_height="45dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/signin_background"
            android:hint="Password"
            android:padding="5dp"
            android:textColor="#EBCCCC"
            android:textColorHint="#EBCCCC"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/userEdit" />

        <EditText
            android:inputType="textPassword"
            android:id="@+id/confirmPassEdit"
            android:layout_width="290dp"
            android:layout_height="45dp"
            android:layout_marginTop="68dp"
            android:background="@drawable/signin_background"
            android:hint="Confirm Password"
            android:padding="5dp"
            android:textColor="#EBCCCC"
            android:textColorHint="#EBCCCC"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/userEdit" />

        <EditText
            android:id="@+id/birthEdit"
            android:layout_width="290dp"
            android:layout_height="45dp"
            android:layout_marginTop="124dp"
            android:background="@drawable/signin_background"
            android:hint="Birthdate"
            android:padding="5dp"
            android:textColor="#EBCCCC"
            android:textColorHint="#EBCCCC"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.531"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/userEdit" />

        <EditText
            android:id="@+id/phnEdit"
            android:layout_width="290dp"
            android:layout_height="45dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/signin_background"
            android:hint="Phone Number"
            android:padding="5dp"
            android:textColor="#EBCCCC"
            android:textColorHint="#EBCCCC"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.531"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/birthEdit" />

        <LinearLayout
            android:id="@+id/termsContainer"
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/phnEdit">

            <CheckBox
                android:id="@+id/termsChk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#EBCCCC"
                android:text="I agree to the "
                android:textColor="#EBCCCC"
                android:textSize="12dp" />

            <TextView
                android:id="@+id/tvTermsLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terms &amp; Conditions"
                android:textColor="#FFAAAA"
                android:textStyle="bold|italic"
                android:textSize="12dp" />

        </LinearLayout>

        <Button
            android:id="@+id/signupBtn"
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:backgroundTint="#43000000"
            android:text="Sign Up"
            android:textColor="#EBCCCC"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/termsContainer"
            app:layout_constraintVertical_bias="0.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>